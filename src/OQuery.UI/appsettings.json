{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      //"Microsoft.AspNetCore": "Information",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Information"
    }
  },
  "AllowedHosts": "*",


  "DbProvider": {
    "DefaultDbOption": "{ConnectionOptions:0}", /* select default dbconnection */
    "AllowDirectConnections": false,
    "DBVersion": "1",
    "DbScriptsPath": "../../oquery/data-storage/scripts",
    "UseCases": [ "northstar-demo", "unit-test" ] /* unit-test, sale-demo, northstar-demo */
  },

  "ConnectionOptions": [
    {
      "Name": "Sqlite In Memory",
      "ConnectionString": "{ConnectionStrings:Sqlite}",
      "Provider": "Sqlite"
    },
    {
      "Name": "SqlServer Docker",
      "ConnectionString": "{ConnectionStrings:SqlServer}",
      "Provider": "SqlServer"
    },
    {
      "Name": "Postgres Docker",
      "ConnectionString": "{ConnectionStrings:Postgres}",
      "Provider": "Postgres"
    },
    {
      "Name": "CockroachDB Docker",
      "ConnectionString": "{ConnectionStrings:Cockroach}",
      "Provider": "Cockroach"
    },
    {
      "Name": "MySQL Docker",
      "ConnectionString": "{ConnectionStrings:MySql}",
      "Provider": "MySql"
    },
    {
      "Name": "Firebird Docker",
      "ConnectionString": "{ConnectionStrings:Firebird}",
      "Provider": "Firebird"
    },
    {
      "Name": "Oracle Docker",
      "ConnectionString": "{ConnectionStrings:Oracle}",
      "Provider": "Oracle"
    },
    {
      "Name": "Db2 Docker",
      "ConnectionString": "{ConnectionStrings:Db2}",
      "Provider": "Db2"
    }
  ],

  "ConnectionStrings": {
    "Sqlite": "Data Source=:memory:",
    "SqlServer": "Server=localhost;Database=DynamicSqlTest;User Id=sa;Password=NoPassword123!;TrustServerCertificate=True;",
    "Postgres": "Host=localhost;Port=5432;Database=DynamicSqlTest;Username=postgres;Password=NoPassword123!;",
    "Cockroach": "Host=localhost;Port=26257;Database=defaultdb;Username=root;Ssl Mode=Disable;",
    "MySql": "Server=localhost;Port=3306;Database=northstar;User ID=root;Password=NoPassword123!;",
    "SapHana": "Server=localhost:39017;UserID=SYSTEM;Password=NoPassword123!;",
    "Firebird": "User=SYSDBA;Password=NoPassword123!;Database=localhost:/firebird/data/northstar.fdb",
    "Oracle": "User Id=NORTHSTAR;Password=NoPassword123!;Data Source=localhost:1521/FREEPDB1",
    "Db2": "Server=localhost:50000;Database=NORTHSTA;UID=db2inst1;PWD=NoPassword123!;"
  },

  "StorageProvider": "Files",
  "FileStoragePath": "../../data-storage",
  "MetadataPath": "../../oquery/data-storage/metadata"
}
