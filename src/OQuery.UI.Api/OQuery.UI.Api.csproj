<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<PlatformTarget>x64</PlatformTarget>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
		<UserSecretsId>ffcded9a-4133-429d-805e-2ddb773cae17</UserSecretsId>

		<!--Scripts folder is outside  of the solution folder, 
		so we need to set the DockerfileContext to parent of SolutionDir.-->
		<DockerfileContext>$(SolutionDir)..</DockerfileContext>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" />
		<PackageReference Include="Swashbuckle.AspNetCore" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\OQuery.UI.Abstracts\OQuery.UI.Abstracts.csproj" />
		<ProjectReference Include="..\OQuery.UI.Storage.Files\OQuery.UI.Storage.Files.csproj" />
		<ProjectReference Include="..\OQuery.UI.Storage.Postgres\OQuery.UI.Storage.Postgres.csproj" />
		<ProjectReference Include="..\..\oquery\src\OQuery.Core\OQuery.Core.csproj" />
		<ProjectReference Include="..\OQuery.UI.SetupTests\OQuery.UI.SetupTests.csproj" />
		<PackageReference Include="Namh.Configuration.Template" />
		<PackageReference Include="Microsoft.Data.SqlClient" />
	</ItemGroup>

</Project>
