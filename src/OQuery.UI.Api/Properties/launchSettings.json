{
  "profiles": {
    "Local": {
      "commandName": "Project",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "dotnetRunMessages": true,
      "applicationUrl": "http://localhost:21210"
    },
    "Dockerfile": {
      "commandName": "Docker",
      "launchUrl": "{Scheme}://{ServiceHost}:{ServicePort}",
      "environmentVariables": {
        "OQuery__DbProvider__Provider": "Sqlite",
        "OQuery__Repositories__Files__UserDataStorePath": "/tmp/file-storage/UserData"
      },
      "httpPort": 21210, /* Fixed VS port for HTTP */
      "publishAllPorts": false,
      "useSSL": false
    },
    "Dockerfile-Volume": {
      "commandName": "Docker",
      "launchUrl": "{Scheme}://{ServiceHost}:{ServicePort}",
      "environmentVariables": {
        "OQuery__DbProvider__Provider": "Sqlite",
        "OQuery__Repositories__Files__UserDataStorePath": "../var/data/UserData"
      },
      "containerRunArguments": "-v \"{ProjectDir}/../../data-storage:/var/data\"",
      "httpPort": 21210, /* Fixed VS port for HTTP */
      "publishAllPorts": false,
      "useSSL": false
    }

  },
  "$schema": "https://json.schemastore.org/launchsettings.json"
}