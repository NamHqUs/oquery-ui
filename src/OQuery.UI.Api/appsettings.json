{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      //"Microsoft.AspNetCore": "Information",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Information"
    }
  },
  "AllowedHosts": "*",

  "FileStorePath": "../../oquery/data-storage",

  "OQuery": {
    "Seeds": {
      "Enabled": true,
      "DBVersion": "1",
      "BasePath": "{FileStorePath}",
      "DataSets": [ "northstar-demo", "unit-test" ]
    },
    "Repositories": {
      "Files": {
        "UserData": "../../.data-storage/userdata"
      },
      "Postgres": {
        //"ConnectionString": "{ConnectionStrings:Analytics}"
      }
    },
    "Analytics": {
      "FlushIntervalSeconds": 60
    },
    "DbProvider": {
      "Provider": "SqlServer",
      "ConnectionString": "{ConnectionStrings:SqlServer}"
    },
    "Security": {
      "EncryptionKey": ""
    }
  },

  "ConnectionStrings": {
    "Sqlite": "Data Source=:memory:",
    "SqlServer": "Server=localhost;Database=DynamicSqlTest;User Id=sa;Password=NoPassword123!;Connect Timeout=2;TrustServerCertificate=True;",
    "Analytics": "Host=localhost;Port=5432;Database=oquery;Username=postgres;Password=NoPassword123!;"
  }
}
