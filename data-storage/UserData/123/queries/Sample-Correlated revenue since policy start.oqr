Policies: Id PolicyId,
    Concat(User.FirstName, < >, User.LastName) Member,
    Coalesce(RevenueSinceStart.PremiumRevenue, <0>) RevenueSinceSignup
  Order PolicyId ASC
  Left Join RevenueSinceStart RevenueSinceStart On Id = RevenueSinceStart.PolicyId
RevenueSinceStart is PremiumPayments: PolicyId PolicyId, SUM(Amount) PremiumRevenue
  Where Status = <Paid> AND PaymentDate >= Policy.StartDate
