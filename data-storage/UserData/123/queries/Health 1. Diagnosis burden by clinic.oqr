Visits: Diagnosis.Name Diagnosis,
    Diagnosis.Category DiagnosisCategory,
    Location.City ClinicCity,
    CountDistinct(Id) VisitCount,
    CountDistinct(UserId) UniquePatients,
    ROUND(AVG(Charge), <2>) AverageCharge,
    ROUND(<100.0> * SUM(Coalesce(VisitLabs.AbnormalCount, <0>)) / NULLIF(SUM(Coalesce(VisitLabs.LabCount, <0>)), <0>), <2>) AbnormalLabPercent
  Where Status = <Completed>
  Order VisitCount DESC, AbnormalLabPercent DESC, Diagnosis.Name ASC, Location.City ASC
  Take 10
  Left Join VisitLabs VisitLabs On Id = VisitLabs.VisitId
VisitLabs is LabResults: VisitId VisitId, COUNT(Id) LabCount, CountIf(IsAbnormal = <True>) AbnormalCount
