Query is MonthlySales: SalesMonth,
    ROUND(Revenue, <2>) Revenue,
    OrderCount,
    ROUND(Lag(Revenue, <1>, SalesMonth), <2>) PriorMonthRevenue,
    ROUND(Difference(Revenue, Lag(Revenue, <1>, SalesMonth)), <2>) RevenueChange,
    ROUND(WindowSum(Revenue, SalesMonth), <2>) RunningRevenue
  Order SalesMonth DESC
  Take 10
  Inner Join MonthlySales MonthlySales
MonthlySales is Orders: MonthKey(OrderDate) SalesMonth,
    SUM(Items.Quantity * Items.UnitPrice - Items.DiscountAmount) Revenue,
    CountDistinct(Id) OrderCount
  Where Status = <Completed>
