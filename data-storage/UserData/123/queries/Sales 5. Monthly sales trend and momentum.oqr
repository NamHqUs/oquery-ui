OrderItems: MonthKey(Order.OrderDate) SalesMonth,
    SUM(Quantity * UnitPrice - DiscountAmount) NetRevenue,
    CountDistinct(OrderId) OrderCount,
    NetRevenue Revenue,
    Lag(NetRevenue, <1>, SalesMonth) PriorMonthRevenue,
    NetRevenue - Lag(NetRevenue, <1>, SalesMonth) RevenueChange,
    WindowSum(NetRevenue, SalesMonth) RunningRevenue
  Where Order.Status = <Completed>
  Order SalesMonth DESC
  Take 10