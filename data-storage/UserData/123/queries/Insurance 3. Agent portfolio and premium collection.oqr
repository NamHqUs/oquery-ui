Agents: Id AgentId,
    Concat(FirstName, < >, LastName) Agent,
    Location.City OfficeCity,
    CountOver(Policies) PoliciesSold,
    Policies.CountIf(Status = <Active>) ActivePolicies,
    Round(IfNull(Policies.Sum(PremiumPayments.SumIf(Amount, Status = <Paid>)), <0>), <2>) PaidPremiums,
    IfNull(Policies.Sum(PremiumPayments.CountIf(Status = <Late>)), <0>) LatePayments,
    IfNull(Policies.Sum(PremiumPayments.CountIf(Status = <Missed>)), <0>) MissedPayments
  Where Department.Name = <Insurance Agency>
  Order PaidPremiums DESC
  Take 10