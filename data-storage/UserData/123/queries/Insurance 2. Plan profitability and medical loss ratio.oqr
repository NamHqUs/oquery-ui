InsurancePlans: Name Plan,
    Tier,
    CountOver(Policies) PolicyCount,
    Round(IfNull(Policies.Sum(PremiumPayments.SumIf(Amount, Status = <Paid>)), <0>), <2>) PremiumRevenue,
    Round(IfNull(Policies.Sum(Claims.Sum(PaidAmount)), <0>), <2>) ClaimsPaid,
    Policies.Sum(CountOver(Claims)) ClaimCount,
    Policies.Sum(Claims.CountIf(Status = <Denied>)) DeniedClaims,
    (100 * IfNull(Policies.Sum(Claims.Sum(PaidAmount)), 0)
/ NullIf(Policies.Sum(PremiumPayments.SumIf(Amount, Status = <Paid>)), 0)).Round(2) MedicalLossRatioPercent
  Order MedicalLossRatioPercent DESC
  Take 10