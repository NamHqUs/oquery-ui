Claims: Policy.Plan.Tier Tier,
    Policy.Plan.Name Plan,
    DenialReason,
    COUNT(Id) DeniedClaims,
    ROUND(SUM(BilledAmount), <2>) BilledAmount,
    ROUND(SUM(AllowedAmount), <2>) AllowedAmount,
    ROUND(AVG(BilledAmount), <2>) AverageBilledAmount
  Where Status = <Denied>
  Order DeniedClaims DESC, BilledAmount DESC
  Take 10
